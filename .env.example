# LLM provider: Ollama (local, free, no API key required)
# Install: https://ollama.com/download
# Then pull the model: ollama pull llama3.2:3b
LLM_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434

# Database location
DATABASE_URL=sqlite:///./backend/app/data/knowledge_base.db

# Retrieval settings
TOP_K=3
# Minimum top-match similarity score (0-1) required before calling the LLM.
# Below this, the query is treated as clearly out-of-scope and answered
# with a fixed "not found" message without an LLM call. Kept low (near
# zero) deliberately — topic-relevant-but-wrong-detail questions (e.g.
# "maternity leave" retrieving "Leave Application") still score well above
# this and are correctly handled by the LLM's grounding instructions
# instead. More detailed explanation is described in rag_service.py
SIMILARITY_THRESHOLD=0.05

# App
LOG_LEVEL=INFO
